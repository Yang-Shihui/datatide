# 服务端口（compose 映射用）
DATATIDE_PORT=8200

# 模型：provider/model-id，来自 ~/.pi/agent/models.json（OpenAI 兼容网关均可）
DATATIDE_MODEL=lab/GLM-5.3-Flash

# 首次启动自动创建的管理员密码（仅在用户表为空时生效）
DATATIDE_ADMIN_PASSWORD=change-me

# 数据与报告目录（compose 内已挂载卷，无需改动）
# DATATIDE_DATA_DIR=/app/data
# DATATIDE_REPORTS_DIR=/app/reports

# 分析技能外部目录（可选，标准 Agent Skills 格式/SKILL.md，内置 skills/ 自动加载）
# DATATIDE_SKILLS_DIR=/path/to/your/skills

# 定时报告的 cron 调度时区（IANA 名称；默认 Asia/Shanghai，避免容器 UTC 差 8 小时）
# DATATIDE_TZ=Asia/Shanghai

# MCP 服务器配置（可选，标准 mcpServers JSON，兼容 Claude/Cursor 的 .mcp.json）
# 示例：{"mcpServers": {"py": {"command": "npx", "args": ["-y", "@pydantic/mcp-run-python", "stdio"]}}}
# DATATIDE_MCP_CONFIG=./mcp.json
